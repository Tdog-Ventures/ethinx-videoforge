# FacelessForge / Emergent local and deployment environment.
# Copy to apps/facelessforge/.env for local frontend work. Configure the
# non-VITE values as Supabase edge-function secrets or render-service runtime
# environment variables; do not expose them in browser bundles.

# Browser Supabase client used by the imported FacelessForge app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional checkout integration used by imported Lovable checkout helpers.
VITE_STRIPE_BACKEND_URL=

# Supabase edge-function runtime.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FacelessForge upstream bridge consumed by render-video, render-video-status,
# and render-video-cancel proxy functions.
FACELESSFORGE_BASE_URL=
FACELESSFORGE_API_KEY=

# External render API runtime placeholders for the FacelessForge service.
EXTERNAL_RENDER_ENABLED=false
EXTERNAL_RENDER_API_KEY=

# Object storage for rendered MP4 files. Use the values for your provider
# (Supabase Storage, S3, R2, GCS-compatible gateway, local disk adapter, etc.).
STORAGE_MODE=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Optional email notification integration.
RESEND_API_KEY=
