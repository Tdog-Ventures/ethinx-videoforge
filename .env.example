# EE-THINKS VideoForge monorepo environment template.
# Copy to .env for local tooling, or export these values in your shell/hosting platform.
# Do not commit real secrets.

# ETHINX browser app (Vite exposes only VITE_* values to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase Edge Functions
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ETHINX -> FacelessForge render bridge used by render-video/status/cancel functions
FACELESSFORGE_BASE_URL=
FACELESSFORGE_API_KEY=

# FacelessForge external render API deployment
EXTERNAL_RENDER_ENABLED=
EXTERNAL_RENDER_API_KEY=

# FacelessForge output storage
STORAGE_MODE=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_PUBLIC_BASE_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Optional local/e2e helpers
E2E_BASE_URL=

# Optional imported Lovable integrations
VITE_STRIPE_BACKEND_URL=
RESEND_API_KEY=
